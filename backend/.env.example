# MongoDB Atlas or another replica-set connection string.
DATABASE_URL="mongodb://127.0.0.1:27017/to2do?replicaSet=rs0"
# Use a random value of at least 32 characters in production.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NODE_ENV="development"
PORT=3001
# Comma-separated browser origins. Required in production.
FRONTEND_URL="http://localhost:3000"
# Optional AI integration. Keep empty until a key is intentionally added.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
